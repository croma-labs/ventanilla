# Country layer to build (src/countries/<code>)
COUNTRY=co
# Public origin used for canonical URLs, sitemap and Open Graph. Set this on any fork you deploy.
SITE_URL=http://localhost:5201

# Required: official sources (https://docs.usecroma.com)
CROMA_API_KEY=
# CROMA_API_URL=https://api.croma.run

# Required: the model. Groq is the default; set AI_PROVIDER=anthropic to use Claude instead.
GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# GROQ_REASONING=
# FAST_REASONING=medium
AI_PROVIDER=
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Required in production: signs assistant turns and rate-limit keys. Generate with `openssl rand -hex 32`.
VENTANILLA_SECRET=

# Optional: shared caches and rate limits. Without them everything falls back to memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
LIMIT_PER_MINUTE=6
LIMIT_PER_DAY=80
# ANSWER_CACHE_SECONDS=21600
# Scrubbed questions and answers kept for the weekly review; 0 turns the journal off.
# JOURNAL_RETENTION_SECONDS=604800

# Optional: `npm run eval` and `npm run tramites` bypass rate limits with this key (24+ chars, server and script must match).
EVAL_KEY=
# EVAL_URL=http://localhost:5201
