{
  "name": "ventanilla",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/croma-labs/ventanilla.git"
  },
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 5201",
    "prebuild": "node --env-file-if-exists=.env.local scripts/corpus.ts && node --env-file-if-exists=.env.local scripts/turismo.ts",
    "build": "astro build",
    "preview": "astro preview --port 5201",
    "check": "astro check",
    "icons": "node scripts/icons.ts",
    "eval": "node --env-file-if-exists=.env.local scripts/eval.ts",
    "tramites": "node --env-file-if-exists=.env.local scripts/tramites.ts",
    "corpus": "node --env-file-if-exists=.env.local scripts/corpus.ts",
    "turismo": "COUNTRY=sv node --env-file-if-exists=.env.local scripts/turismo.ts",
    "omr": "node --env-file-if-exists=.env.local scripts/omr.ts",
    "journal": "node --env-file-if-exists=.env.local scripts/journal.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.92",
    "@ai-sdk/groq": "^4.0.73",
    "@astrojs/react": "^7.1.2",
    "@astrojs/vercel": "^11.0.17",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@upstash/redis": "^1.40.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.10.5",
    "ai": "^7.0.157",
    "astro": "^7.4.4",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.65.0",
    "maplibre-gl": "^5.24.0",
    "minisearch": "^7.2.0",
    "motion": "^14.8.0",
    "ogl": "^1.0.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.36.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "^6.3.0"
    }
  }
}
