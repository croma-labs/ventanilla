---
import "@fontsource-variable/inter-tight/wght.css";
import "@fontsource/instrument-serif/400.css";
import { site } from "@country/site";
import "../styles/global.css";
import serif from "@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url";
import sans from "@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url";

interface Props {
  title: string;
  description: string;
  indexable?: boolean;
  canonical?: string;
  image?: { path: string; width: number; height: number; alt: string };
  schema?: Record<string, unknown>[];
}

const { title, description, indexable = true, canonical: canonicalPath, image: share, schema = [] } = Astro.props;
const origin = Astro.site ?? new URL(Astro.url.origin);
const image = new URL(share?.path ?? "/og.jpg", origin).href;
const url = new URL(canonicalPath ?? Astro.url.pathname, origin).href;
const home = new URL("/", origin).href;
const structured = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${home}#website`,
      url: home,
      name: site.brand.name,
      description: site.meta.description,
      inLanguage: site.locale,
      publisher: { "@id": `${home}#publisher` },
    },
    {
      "@type": "WebApplication",
      "@id": `${home}#app`,
      name: site.brand.name,
      url: home,
      description: `${site.meta.description} ${site.brand.notice}`,
      applicationCategory: "ReferenceApplication",
      operatingSystem: "Web",
      inLanguage: site.locale,
      isAccessibleForFree: true,
      offers: { "@type": "Offer", price: "0", priceCurrency: "COP" },
      audience: { "@type": "Audience", geographicArea: { "@type": "Country", name: "Colombia" } },
      keywords: site.meta.keywords.join(", "),
      image: image,
      publisher: { "@id": `${home}#publisher` },
    },
    { "@type": "Organization", "@id": `${home}#publisher`, name: site.meta.publisher.name, url: site.meta.publisher.url },
    ...schema,
  ],
};
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content={indexable ? "index, follow, max-image-preview:large, max-snippet:-1, noai, noimageai" : "noindex, follow, noai, noimageai"} />
    <link rel="preload" href={serif} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sans} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={site.meta.keywords.join(", ")} />
    <link rel="alternate" hreflang={site.locale} href={url} />
    <link rel="alternate" hreflang="x-default" href={url} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {indexable && <script type="application/ld+json" set:html={JSON.stringify(structured).replace(/</g, "\\u003c")} />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={url} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand.name} />
    <meta property="og:locale" content={site.locale.replace("-", "_")} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content={String(share?.width ?? 1200)} />
    <meta property="og:image:height" content={String(share?.height ?? 630)} />
    <meta property="og:image:alt" content={share?.alt ?? `${site.brand.name}: ${site.brand.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
  </head>
  <body class="font-body text-primary antialiased">
    <slot />
  </body>
</html>
