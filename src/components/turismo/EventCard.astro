---
import { CalendarPlus, Globe, MapPin } from "lucide-react";
import { dateRange } from "../../lib/turismo/catalog";
import type { Happening } from "../../lib/turismo/types";
import { focusRing } from "../../lib/ui";
import BrandIcon, { hasBrand, NETWORK_LABEL } from "./BrandIcon";

interface Props {
  event: Happening;
  variant?: "default" | "compact";
}

const { event, variant = "default" } = Astro.props;
const start = event.start ? new Date(`${event.start}T12:00:00Z`) : null;
const day = start ? new Intl.DateTimeFormat("es-SV", { day: "numeric", timeZone: "UTC" }).format(start) : "";
const month = start ? new Intl.DateTimeFormat("es-SV", { month: "short", timeZone: "UTC" }).format(start).replace(".", "") : "";
const weekday = start ? new Intl.DateTimeFormat("es-SV", { weekday: "short", timeZone: "UTC" }).format(start).replace(".", "") : "";
const compact = (iso: string) => iso.replaceAll("-", "");
const nextDay = (iso: string) => new Date(Date.parse(`${iso}T12:00:00Z`) + 86_400_000).toISOString().slice(0, 10);
const ics =
  event.start &&
  [
    "BEGIN:VCALENDAR",
    "VERSION:2.0",
    "PRODID:-//Ventanilla//Turismo El Salvador//ES",
    "BEGIN:VEVENT",
    `UID:${event.id}@sv.usecroma.com`,
    `DTSTAMP:${new Date().toISOString().replace(/[-:]/g, "").slice(0, 15)}Z`,
    `DTSTART;VALUE=DATE:${compact(event.start)}`,
    `DTEND;VALUE=DATE:${compact(nextDay(event.end ?? event.start))}`,
    `SUMMARY:${event.name.replace(/[,;]/g, "\\$&")}`,
    ...(event.venue ? [`LOCATION:${[event.venue, event.department, "El Salvador"].filter(Boolean).join(", ").replace(/[,;]/g, "\\$&")}`] : []),
    "END:VEVENT",
    "END:VCALENDAR",
  ].join("\r\n");
const width = variant === "compact" ? "w-[78vw] max-w-[320px] shrink-0 snap-start" : "";
---

<article id={event.slug} class={`flex scroll-mt-28 flex-col gap-4 rounded-24 border border-border-quaternary bg-background-primary p-4 ${width}`}>
  <div class="flex gap-4">
    <div class="flex w-16 shrink-0 flex-col items-center self-start overflow-hidden rounded-16 bg-blue-700 text-white" aria-hidden="true">
      <span class="w-full bg-[#f2b33d] py-0.5 text-center text-[11px] font-semibold tracking-wide text-blue-900 uppercase">{month}</span>
      <span class="pt-1 font-serif-display text-[2rem] leading-none">{day}</span>
      <span class="pb-1.5 text-[11px] text-white/70 capitalize">{weekday}</span>
    </div>
    <div class="min-w-0">
      <h3 class="font-serif-display text-[1.4rem] leading-[1.08] text-balance">{event.name}</h3>
      <p class="mt-1 text-[13px] font-medium text-blue-600"><time datetime={event.start ?? undefined}>{dateRange(event.start, event.end)}</time></p>
      {
        (event.venue || event.department) && (
          <p class="mt-1 flex items-start gap-1 text-[13px] text-text-secondary">
            <MapPin size={14} strokeWidth={1.75} class="mt-0.5 shrink-0" />
            {[event.venue, event.department !== event.venue ? event.department : null].filter(Boolean).join(" · ")}
          </p>
        )
      }
    </div>
  </div>
  <div class="mt-auto flex flex-wrap gap-2">
    {
      event.links.map((link) => (
        <a href={link.url} target="_blank" rel="noopener noreferrer" class={`inline-flex h-9 items-center gap-1.5 rounded-full border border-border-tertiary px-3 text-[13px] font-medium hover:bg-surface-muted ${focusRing}`}>
          {hasBrand(link.label) ? <BrandIcon name={link.label} size={14} /> : <Globe size={14} strokeWidth={1.75} />}
          {link.label === "web" ? "Más información" : NETWORK_LABEL[link.label as keyof typeof NETWORK_LABEL] ?? "Más información"}
        </a>
      ))
    }
    {
      ics && (
        <a href={`data:text/calendar;charset=utf-8,${encodeURIComponent(ics)}`} download={`${event.slug}.ics`} class={`inline-flex h-9 items-center gap-1.5 rounded-full border border-border-tertiary px-3 text-[13px] font-medium hover:bg-surface-muted ${focusRing}`}>
          <CalendarPlus size={14} strokeWidth={1.75} />
          Agendar
        </a>
      )
    }
  </div>
</article>
