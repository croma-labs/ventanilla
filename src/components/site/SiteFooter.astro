---
import { site } from "@country/site";
import mark from "@country/brand/mark.svg?raw";
import { chromeOf } from "../../lib/chrome";
import { focusRing } from "../../lib/ui";
import CromaCredit from "./CromaCredit";

interface Props {
  lang?: string;
}

const chrome = chromeOf(Astro.props.lang);
const inlineLink = `inline-block rounded-xs underline-offset-4 hover:underline ${focusRing}`;
const external = (href: string) => (href.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {});
const markMarkup = mark.replace("<svg ", '<svg aria-hidden="true" class="h-7 w-[42px]" ');
---

<footer data-slot="site-footer" class="bg-surface-footer py-24 text-pretty text-black site-desktop:pt-56 site-desktop:pb-30">
  <div class="site-container site-grid gap-y-20 site-desktop:gap-y-36">
    <nav aria-label={Astro.props.lang === "en" ? "Footer" : "Pie de página"} class="col-span-full min-w-0 text-center wrap-anywhere">
      <ul class="type-site-3 flex flex-col items-center gap-2.5 max-mobile:gap-6">
        {
          chrome.nav.primary.map((link) => (
            <li class="max-w-full">
              <a href={link.href} {...external(link.href)} class:list={["block max-w-full rounded-8 px-2 underline-offset-4 hover:underline focus-visible:underline", focusRing]}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="col-span-full flex min-w-0 flex-col items-center gap-6">
      <p class="font-serif-display text-[clamp(4.5rem,18vw,15rem)] leading-[0.9] tracking-[-0.03em] text-text-primary">{site.brand.name}</p>
      <span aria-hidden="true" class="flex h-1.5 w-32 overflow-hidden rounded-full">
        {site.manifesto.flag.map((color) => <span class="flex-1" style={{ background: color }} />)}
      </span>
      <div class="type-site-11 flex w-full min-w-0 flex-col items-center gap-6 pt-4 pb-8 text-center">
        <p class="flex max-w-xl flex-col items-center gap-4 text-text-secondary">
          <Fragment set:html={markMarkup} />
          {chrome.disclaimer}
        </p>
        <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
          {chrome.nav.legal.map((link) => <a href={link.href} {...external(link.href)} class={inlineLink}>{link.label}</a>)}
          <CromaCredit label={chrome.poweredBy} />
        </div>
      </div>
    </div>
  </div>
</footer>
