---
import { site } from "@country/site";
import Markdown from "../../components/chat/Markdown";
import SiteFooter from "../../components/site/SiteFooter.astro";
import SiteHeader from "../../components/site/SiteHeader.astro";
import TramiteCards from "../../components/tramites/TramiteCards.astro";
import Base from "../../layouts/Base.astro";
import { agencyFor } from "../../components/chat/sources";
import { iconOf } from "../../data/orbit";
import { focusRing } from "../../lib/ui";
import { dateLabel, pathOf, published, summaryOf, type Published } from "../../lib/tramites";

export const getStaticPaths = () => published.map((tramite) => ({ params: { slug: tramite.slug }, props: { tramite } }));

const { tramite } = Astro.props as { tramite: Published };
const copy = site.tramitesPage;
const origin = Astro.site ?? new URL(Astro.url.origin);
const url = new URL(pathOf(tramite.slug), origin).href;
const home = new URL("/", origin).href;
const index = new URL("/tramites", origin).href;
const heading = `${tramite.title} ${copy.suffix}`;
const lead = summaryOf(tramite.answer);
const description = lead.length < 110 ? `${lead} ${copy.tail}` : lead;
const photo = tramite.image ? `/hero/${site.code}/${tramite.image}` : null;
const verified = copy.verified.replace("{date}", dateLabel(tramite.verifiedAt));
const others = published.filter((other) => other.slug !== tramite.slug);
const related = [...others.filter((other) => other.category === tramite.category), ...others.filter((other) => other.category !== tramite.category)].slice(0, 6);
const askHref = `/?q=${encodeURIComponent(tramite.question)}`;

const schema = [
  {
    "@type": "WebPage",
    "@id": `${url}#page`,
    url,
    name: heading,
    description,
    inLanguage: site.locale,
    isPartOf: { "@id": `${home}#website` },
    dateModified: tramite.verifiedAt,
    breadcrumb: { "@id": `${url}#breadcrumb` },
    ...(photo ? { primaryImageOfPage: new URL(`${photo}.webp`, origin).href } : {}),
    about: {
      "@type": "GovernmentService",
      name: tramite.title,
      areaServed: { "@type": "Country", name: "Colombia" },
      provider: { "@type": "GovernmentOrganization", name: tramite.agency.name, url: `https://www.${tramite.agency.domain}` },
    },
    citation: tramite.sources.map((source) => ({ "@type": "CreativeWork", name: source.title, url: source.url })),
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${url}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: copy.home, item: home },
      { "@type": "ListItem", position: 2, name: copy.heading, item: index },
      { "@type": "ListItem", position: 3, name: tramite.title, item: url },
    ],
  },
];

const host = (href: string) => new URL(href).hostname.replace(/^www\./, "");
const link = `rounded-4 underline-offset-4 hover:underline ${focusRing}`;
---

<Base
  title={`${heading} | ${site.brand.name}`}
  description={description}
  schema={schema}
  image={photo ? { path: `${photo}.webp`, width: 1344, height: 896, alt: tramite.title } : undefined}
>
  <div class="relative flex min-h-dvh flex-col bg-background-primary text-primary">
    <SiteHeader />
    <main id="landing-main" tabindex="-1" class="flex-1 pt-28 pb-24 outline-none mobile:pt-40">
      <article class="mx-auto w-full max-w-[720px] px-4 mobile:px-6">
        <nav aria-label="Migas de pan" class="type-body-s text-text-secondary">
          <ol class="flex flex-wrap items-center gap-1.5">
            <li><a href="/" class={link}>{copy.home}</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/tramites" class={link}>{copy.heading}</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page" class="text-text-primary">{tramite.title}</li>
          </ol>
        </nav>

        <h1 class="mt-6 font-serif-display text-[clamp(2.5rem,7vw,4rem)] leading-[1] tracking-[-0.02em] text-balance text-text-primary">{heading}</h1>

        <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 type-body-s text-text-secondary">
          <a href={`https://www.${tramite.agency.domain}`} target="_blank" rel="noopener noreferrer" class={`inline-flex items-center gap-2 rounded-full bg-surface-muted py-1 pr-3.5 pl-1 text-[13px] font-medium text-text-primary ${focusRing}`}>
            <img src={tramite.agency.icon} alt="" width="24" height="24" class="size-6 rounded-full bg-white object-contain p-0.5" />
            <span class="text-text-secondary">{site.brand.handledBy}</span>
            {tramite.agency.name}
          </a>
          <span class="inline-flex items-center gap-1.5">
            <svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3.5 8.5 6.5 11.5 12.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <time datetime={tramite.verifiedAt}>{verified}</time>
          </span>
        </div>

        {
          photo && (
            <img
              src={`${photo}.webp`}
              srcset={`${photo}-640.webp 640w, ${photo}-800.webp 800w, ${photo}.webp 1344w`}
              sizes="(min-width: 768px) 720px, calc(100vw - 32px)"
              alt={site.hero.cards.find((card) => card.image === tramite.image)?.alt ?? tramite.title}
              width="1344"
              height="896"
              fetchpriority="high"
              decoding="async"
              class="mt-8 aspect-3/2 w-full rounded-24 object-cover"
            />
          )
        }

        <section class="mt-10" aria-labelledby="answer">
          <h2 id="answer" class="type-body-s font-medium tracking-wide text-text-secondary uppercase">{copy.answer}</h2>
          <div class="mt-4 text-[1.0625rem]">
            <Markdown text={tramite.answer} animate={false} links={tramite.sources.map((source) => source.url)} />
          </div>
        </section>

        <section class="mt-12 rounded-24 bg-surface-muted p-6 mobile:p-8" aria-labelledby="sources">
          <h2 id="sources" class="font-serif-display text-3xl text-text-primary">{copy.sources}</h2>
          <ul class="mt-5 flex flex-col gap-3">
            {
              tramite.sources.map((source) => (
                <li>
                  <a href={source.url} target="_blank" rel="noopener noreferrer" class={`group flex items-start gap-3 rounded-12 ${focusRing}`}>
                    <span class="mt-0.5 size-7 shrink-0 overflow-hidden rounded-full bg-white p-1 ring-1 ring-black/5">
                      <img src={iconOf(agencyFor(source.url).icon)} alt="" width="20" height="20" loading="lazy" class="size-full object-contain" />
                    </span>
                    <span class="flex min-w-0 flex-col">
                      <span class="type-body-m text-pretty text-text-primary group-hover:underline">{source.title.trim() || agencyFor(source.url).name}</span>
                      <span class="type-body-s text-text-secondary">{agencyFor(source.url).name} · {host(source.url)}</span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="mt-8 flex flex-col items-start gap-4 rounded-24 border border-border-tertiary p-6 mobile:p-8" aria-labelledby="ask">
          <h2 id="ask" class="font-serif-display text-3xl text-text-primary">{copy.askTitle}</h2>
          <p class="type-body-m text-text-secondary">{copy.askBody}</p>
          <a href={askHref} rel="nofollow" class={`inline-flex h-12 items-center gap-2 rounded-full bg-blue-700 px-6 font-medium text-white hover:bg-blue-800 ${focusRing}`}>
            {copy.askCta}
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="M4 10h12m0 0-5-5m5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </a>
        </section>

        <p class="mt-8 type-body-s text-pretty text-text-secondary">{copy.disclaimer}</p>
      </article>

      <section class="mx-auto mt-20 w-full max-w-[1080px] px-4 mobile:px-6" aria-labelledby="related">
        <div class="flex items-end justify-between gap-4">
          <h2 id="related" class="font-serif-display text-4xl text-text-primary">{copy.related}</h2>
          <a href="/tramites" class={`type-body-m font-medium text-text-primary ${link}`}>{copy.all}</a>
        </div>
        <TramiteCards items={related} />
      </section>
    </main>
    <SiteFooter />
  </div>
</Base>
