---
import EventCard from "../components/turismo/EventCard.astro";
import { formatDate, langOf, LOCALE, sectionPath, upcoming } from "../lib/turismo/catalog";
import type { Happening } from "../lib/turismo/types";
import Layout from "./Layout.astro";

const lang = langOf(Astro.url.pathname);
const origin = Astro.site ?? new URL(Astro.url.origin);
const url = new URL(sectionPath("events", lang), origin).href;
const all = upcoming();
const months = new Map<string, Happening[]>();
for (const event of all) {
  const key = (event.start ?? "").slice(0, 7);
  months.set(key, [...(months.get(key) ?? []), event]);
}
const monthLabel = (key: string) => formatDate(`${key}-15`, lang, { month: "long", year: "numeric" });
const COPY = {
  es: {
    title: "Eventos en El Salvador: festivales, ferias y conciertos | Ventanilla",
    description: `${all.length} eventos próximos en El Salvador: festivales, ferias, conciertos y fiestas de la agenda oficial del Ministerio de Turismo, con fechas y lugares.`,
    page: "Agenda de eventos en El Salvador",
    heading: "Agenda de El Salvador",
    intro: `${all.length} eventos que aún no terminan, de la agenda oficial del Ministerio de Turismo. Agrégalos a tu calendario con un toque.`,
    empty: "No hay eventos próximos en la agenda oficial por ahora.",
  },
  en: {
    title: "Events in El Salvador: festivals, fairs and concerts | Ventanilla",
    description: `${all.length} upcoming events in El Salvador: festivals, fairs, concerts and town celebrations from the Ministry of Tourism's official calendar, with dates and venues.`,
    page: "Events calendar for El Salvador",
    heading: "What's on in El Salvador",
    intro: `${all.length} events that haven't ended yet, from the Ministry of Tourism's official calendar. Add any of them to your calendar with one tap.`,
    empty: "There are no upcoming events on the official calendar right now.",
  },
  pt: {
    title: "Eventos em El Salvador: festivais, feiras e concertos | Ventanilla",
    description: `${all.length} eventos em El Salvador: festivais, feiras, concertos e festas populares da agenda oficial do Ministério do Turismo, com datas e locais.`,
    page: "Agenda de eventos de El Salvador",
    heading: "O que se passa em El Salvador",
    intro: `${all.length} eventos que ainda não terminaram, da agenda oficial do Ministério do Turismo. Adicione qualquer um ao seu calendário com um toque.`,
    empty: "De momento não há eventos próximos na agenda oficial.",
  },
  fr: {
    title: "Événements au Salvador : festivals, foires et concerts | Ventanilla",
    description: `${all.length} événements à venir au Salvador : festivals, foires, concerts et fêtes patronales de l'agenda officiel du ministère du Tourisme, avec dates et lieux.`,
    page: "Agenda des événements au Salvador",
    heading: "Que faire au Salvador",
    intro: `${all.length} événements qui ne sont pas encore terminés, issus de l'agenda officiel du ministère du Tourisme. Ajoutez-les à votre calendrier d'un simple geste.`,
    empty: "Aucun événement à venir dans l'agenda officiel pour le moment.",
  },
}[lang];
const schema = [
  {
    "@type": "CollectionPage",
    "@id": `${url}#page`,
    url,
    name: COPY.page,
    description: COPY.description,
    inLanguage: LOCALE[lang],
    mainEntity: {
      "@type": "ItemList",
      itemListElement: all.map((event, index) => ({
        "@type": "ListItem",
        position: index + 1,
        item: {
          "@type": "Event",
          name: event.name,
          url: `${url}#${event.slug}`,
          ...(event.start ? { startDate: event.start, endDate: event.end ?? event.start } : {}),
          eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
          eventStatus: "https://schema.org/EventScheduled",
          location: { "@type": "Place", name: event.venue ?? event.department ?? "El Salvador", address: { "@type": "PostalAddress", ...(event.department ? { addressRegion: event.department } : {}), addressCountry: "SV" } },
          ...(event.links.length ? { sameAs: event.links.map((link) => link.url) } : {}),
        },
      })),
    },
  },
];
---

<Layout title={COPY.title} description={COPY.description} current="events" schema={schema}>
  <header class="mt-6">
    <h1 class="font-serif-display text-[clamp(2.4rem,7vw,4rem)] leading-[0.95] tracking-[-0.02em]">{COPY.heading}</h1>
    <p class="mt-3 max-w-[52ch] text-[17px] text-text-secondary">{COPY.intro}</p>
  </header>
  {
    [...months.entries()].map(([key, items]) => (
      <section class="mt-10" aria-labelledby={`mes-${key}`}>
        <h2 id={`mes-${key}`} class="sticky top-14 z-10 -mx-4 bg-background-primary/90 px-4 py-2 font-serif-display text-[2rem] leading-none capitalize backdrop-blur mobile:-mx-6 mobile:px-6">{monthLabel(key)}</h2>
        <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2 site-desktop:grid-cols-3">
          {items.map((event) => <EventCard event={event} lang={lang} />)}
        </div>
      </section>
    ))
  }
  {all.length === 0 && <p class="mt-10 text-[17px] text-text-secondary">{COPY.empty}</p>}
</Layout>
