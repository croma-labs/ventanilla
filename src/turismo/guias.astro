---
import { DEPARTMENTS, GUIDE_LEVEL_LABEL, KIND_LABEL, langOf, LANGUAGE_LABEL, LOCALE, PARAM, places, sectionPath } from "../lib/turismo/catalog";
import { focusRing } from "../lib/ui";
import Layout from "./Layout.astro";

const lang = langOf(Astro.url.pathname);
const guides = places.filter((place) => place.kind === "guide").sort((a, b) => a.name.localeCompare(b.name, "es"));
const languages = [...new Set(guides.flatMap((guide) => guide.languages))].filter((code) => code !== "es");
const departments = DEPARTMENTS.filter((name) => guides.some((guide) => guide.department === name));
const origin = Astro.site ?? new URL(Astro.url.origin);
const url = new URL(sectionPath("guides", lang), origin).href;
const spoken = languages.map((code) => LANGUAGE_LABEL[lang][code] ?? code).join(", ");
const COPY = {
  es: {
    title: "Guías de turismo certificados en El Salvador | Ventanilla",
    description: `${guides.length} guías de turismo certificados en El Salvador, de sitio, locales y nacionales, con los idiomas en que trabajan: ${spoken} y español.`,
    heading: "Guías certificados",
    intro: `${guides.length} guías de turismo certificados por el Ministerio de Turismo. Son personas: aquí ves su nombre, idiomas y zona. Para contratar uno, consulta en el sitio turístico o con un tour operador registrado.`,
    language: "Idioma",
    allLanguages: "Todos los idiomas",
    department: "Departamento",
    country: "Todo el país",
    one: "guía",
    many: "guías",
  },
  en: {
    title: "Certified tour guides in El Salvador | Ventanilla",
    description: `${guides.length} tour guides certified in El Salvador, at site, local and national level, with the languages they work in: ${spoken} and Spanish.`,
    heading: "Certified tour guides",
    intro: `${guides.length} tour guides certified by the Ministry of Tourism. They are private people, so you only see their name, languages and area here. To hire one, ask at the tourist site or through a registered tour operator.`,
    language: "Language",
    allLanguages: "All languages",
    department: "Department",
    country: "Whole country",
    one: "guide",
    many: "guides",
  },
  pt: {
    title: "Guias turísticos certificados em El Salvador | Ventanilla",
    description: `${guides.length} guias turísticos certificados em El Salvador, de local, locais e nacionais, com os idiomas em que trabalham: ${spoken} e espanhol.`,
    heading: "Guias certificados",
    intro: `${guides.length} guias turísticos certificados pelo Ministério do Turismo. São pessoas particulares, por isso aqui só vê o nome, os idiomas e a zona. Para contratar um, pergunte no local turístico ou a um operador turístico registado.`,
    language: "Idioma",
    allLanguages: "Todos os idiomas",
    department: "Departamento",
    country: "Todo o país",
    one: "guia",
    many: "guias",
  },
  fr: {
    title: "Guides touristiques certifiés au Salvador | Ventanilla",
    description: `${guides.length} guides touristiques certifiés au Salvador, de site, locaux et nationaux, avec les langues dans lesquelles ils travaillent : ${spoken} et espagnol.`,
    heading: "Guides certifiés",
    intro: `${guides.length} guides touristiques certifiés par le ministère du Tourisme. Ce sont des particuliers : vous ne voyez ici que leur nom, leurs langues et leur zone. Pour en engager un, renseignez-vous sur le site touristique ou auprès d'un voyagiste enregistré.`,
    language: "Langue",
    allLanguages: "Toutes les langues",
    department: "Département",
    country: "Tout le pays",
    one: "guide",
    many: "guides",
  },
}[lang];
const description = COPY.description;
const schema = [{ "@type": "CollectionPage", "@id": `${url}#page`, url, name: COPY.title.replace(" | Ventanilla", ""), description, inLanguage: LOCALE[lang] }];
const option = `inline-flex h-10 shrink-0 items-center rounded-full border border-border-tertiary px-4 text-[14px] font-medium hover:bg-surface-muted aria-pressed:border-blue-700 aria-pressed:bg-blue-700 aria-pressed:text-white ${focusRing}`;
---

<Layout title={COPY.title} description={description} current="guides" schema={schema}>
  <header class="mt-6">
    <h1 class="font-serif-display text-[clamp(2.4rem,7vw,4rem)] leading-[0.95] tracking-[-0.02em]">{COPY.heading}</h1>
    <p class="mt-3 max-w-[56ch] text-[17px] text-text-secondary">{COPY.intro}</p>
  </header>

  <div class="mt-6 flex flex-col gap-3" data-guide-filters data-one={COPY.one} data-many={COPY.many} data-param={PARAM[lang].language}>
    <div class="-mx-4 flex gap-2 overflow-x-auto px-4 [scrollbar-width:none] mobile:-mx-6 mobile:px-6 [&::-webkit-scrollbar]:hidden" role="group" aria-label={COPY.language}>
      <button type="button" class={option} data-lang="" aria-pressed="true">{COPY.allLanguages}</button>
      {languages.map((code) => <button type="button" class={option} data-lang={code} aria-pressed="false">{LANGUAGE_LABEL[lang][code] ?? code}</button>)}
    </div>
    <label class="flex items-center gap-3 text-[14px]">
      <span class="text-text-secondary">{COPY.department}</span>
      <select data-dept class="h-10 rounded-full border border-border-tertiary bg-background-primary px-3 text-[14px]">
        <option value="">{COPY.country}</option>
        {departments.map((name) => <option value={name}>{name}</option>)}
      </select>
    </label>
    <p class="text-[14px] text-text-secondary" aria-live="polite" data-count>{guides.length} {COPY.many}</p>
  </div>

  <ul class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2 site-desktop:grid-cols-3">
    {
      guides.map((guide) => (
        <li id={guide.slug} class="scroll-mt-28 rounded-24 border border-border-quaternary p-5" data-langs={guide.languages.join(" ")} data-dept={guide.department ?? ""}>
          <p class="text-[12px] font-medium tracking-wide text-text-tertiary uppercase">{guide.guideLevel ? GUIDE_LEVEL_LABEL[lang][guide.guideLevel] : KIND_LABEL[lang].guide.one}</p>
          <h2 class="mt-1.5 font-serif-display text-[1.5rem] leading-[1.05]">{guide.name}</h2>
          {[guide.municipality, guide.department].filter(Boolean).length > 0 && <p class="mt-1 text-[14px] text-text-secondary">{[guide.municipality, guide.department].filter(Boolean).join(", ")}</p>}
          {guide.languages.length > 0 && (
            <ul class="mt-3 flex flex-wrap gap-1.5">
              {guide.languages.map((code) => <li class="rounded-full bg-surface-muted px-2.5 py-1 text-[12px] font-medium">{LANGUAGE_LABEL[lang][code] ?? code}</li>)}
            </ul>
          )}
        </li>
      ))
    }
  </ul>
</Layout>

<script>
  const root = document.querySelector<HTMLElement>("[data-guide-filters]");
  const cards = [...document.querySelectorAll<HTMLElement>("[data-langs]")];
  let language = "";
  let department = "";
  const apply = () => {
    let shown = 0;
    for (const card of cards) {
      const visible = (!language || (card.dataset.langs ?? "").split(" ").includes(language)) && (!department || card.dataset.dept === department);
      card.hidden = !visible;
      if (visible) shown++;
    }
    const count = root?.querySelector("[data-count]");
    if (count) count.textContent = `${shown} ${shown === 1 ? root?.dataset.one : root?.dataset.many}`;
  };
  root?.querySelectorAll<HTMLButtonElement>("[data-lang]").forEach((button) =>
    button.addEventListener("click", () => {
      language = button.dataset.lang ?? "";
      root.querySelectorAll("[data-lang]").forEach((other) => other.setAttribute("aria-pressed", String(other === button)));
      apply();
    }),
  );
  root?.querySelector<HTMLSelectElement>("[data-dept]")?.addEventListener("change", (event) => {
    department = (event.target as HTMLSelectElement).value;
    apply();
  });
  const preset = new URLSearchParams(location.search).get(root?.dataset.param ?? "idioma");
  if (preset) root?.querySelector<HTMLButtonElement>(`[data-lang="${CSS.escape(preset)}"]`)?.click();
</script>
