---
import ExploreApp from "../components/turismo/ExploreApp";
import { counts, KIND_LABEL, places } from "../lib/turismo/catalog";
import Layout from "./Layout.astro";

const origin = Astro.site ?? new URL(Astro.url.origin);
const url = new URL("/turismo/explorar", origin).href;
const byKind = counts();
const description = `Busca y filtra ${places.length.toLocaleString("es-SV")} lugares turísticos de El Salvador en un mapa: ${[...byKind.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 4)
  .map(([kind, count]) => `${count.toLocaleString("es-SV")} ${KIND_LABEL[kind].many.toLowerCase()}`)
  .join(", ")} y más, del directorio oficial del Ministerio de Turismo.`;
const schema = [
  {
    "@type": "CollectionPage",
    "@id": `${url}#page`,
    url,
    name: "Explorar El Salvador: mapa de lugares turísticos",
    description,
    inLanguage: "es-SV",
    about: { "@type": "Country", name: "El Salvador" },
  },
];
---

<Layout title="Explorar El Salvador: mapa de hoteles, restaurantes, playas y guías | Ventanilla" description={description} current="explorar" schema={schema}>
  <h1 class="mt-6 font-serif-display text-[clamp(2.2rem,6vw,3.25rem)] leading-none tracking-[-0.02em]">Explora El Salvador</h1>
  <ExploreApp client:load total={places.length} />
</Layout>
