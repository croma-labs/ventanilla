---
import EventCard from "../components/turismo/EventCard.astro";
import KindIcon from "../components/turismo/KindIcon";
import PlaceCard from "../components/turismo/PlaceCard.astro";
import TurismoSearch from "../components/turismo/TurismoSearch";
import { byDepartment, counts, departmentPath, DEPARTMENT_LEAD, DEPARTMENTS, exploreHref, KIND_LABEL, langOf, LOCALE, places, placePath, sectionPath, THEME_LABEL, upcoming } from "../lib/turismo/catalog";
import { picture } from "../lib/turismo/images";
import type { Kind, Theme } from "../lib/turismo/types";
import { focusRing } from "../lib/ui";
import Layout from "./Layout.astro";

const lang = langOf(Astro.url.pathname);
const origin = Astro.site ?? new URL(Astro.url.origin);
const url = new URL(sectionPath("home", lang), origin).href;
const number = (value: number) => value.toLocaleString(LOCALE[lang]);
const total = places.length;
const byKind = counts();
const soon = upcoming().slice(0, 10);
const destinations = places.filter((place) => place.kind === "destination" || place.kind === "attraction");
const ROWS: Record<typeof lang, { theme: Theme; title: string; lead: string }[]> = {
  es: [
    { theme: "surf_city", title: "Surf City", lead: "Olas de clase mundial a una hora de la capital." },
    { theme: "towns", title: "Pueblos con encanto", lead: "Calles empedradas, café, artesanía y fiestas patronales." },
    { theme: "nature_adventure", title: "Naturaleza y aventura", lead: "Volcanes, lagos, bosques nublados y miradores." },
    { theme: "bitcoin", title: "Destinos Bitcoin", lead: "Donde nació la economía bitcoin del país." },
    { theme: "archaeology", title: "El Salvador maya", lead: "Tazumal, Joya de Cerén, San Andrés y Cihuatán." },
    { theme: "wellness", title: "Termales y bienestar", lead: "Aguas termales y descanso en la montaña." },
  ],
  en: [
    { theme: "surf_city", title: "Surf City", lead: "World-class waves an hour from the capital." },
    { theme: "towns", title: "Charming towns", lead: "Cobblestone streets, coffee, crafts and patron saint festivals." },
    { theme: "nature_adventure", title: "Nature and adventure", lead: "Volcanoes, lakes, cloud forests and lookouts." },
    { theme: "bitcoin", title: "Bitcoin destinations", lead: "Where the country's bitcoin economy began." },
    { theme: "archaeology", title: "Maya El Salvador", lead: "Tazumal, Joya de Cerén, San Andrés and Cihuatán." },
    { theme: "wellness", title: "Hot springs and wellness", lead: "Thermal waters and mountain retreats." },
  ],
  pt: [
    { theme: "surf_city", title: "Surf City", lead: "Ondas de classe mundial a uma hora da capital." },
    { theme: "towns", title: "Vilas com encanto", lead: "Ruas de calçada, café, artesanato e festas populares." },
    { theme: "nature_adventure", title: "Natureza e aventura", lead: "Vulcões, lagos, florestas nubladas e miradouros." },
    { theme: "bitcoin", title: "Destinos Bitcoin", lead: "Onde nasceu a economia bitcoin do país." },
    { theme: "archaeology", title: "El Salvador maia", lead: "Tazumal, Joya de Cerén, San Andrés e Cihuatán." },
    { theme: "wellness", title: "Termas e bem-estar", lead: "Águas termais e descanso na montanha." },
  ],
  fr: [
    { theme: "surf_city", title: "Surf City", lead: "Des vagues de classe mondiale à une heure de la capitale." },
    { theme: "towns", title: "Villages de charme", lead: "Rues pavées, café, artisanat et fêtes patronales." },
    { theme: "nature_adventure", title: "Nature et aventure", lead: "Volcans, lacs, forêts de nuages et belvédères." },
    { theme: "bitcoin", title: "Destinations Bitcoin", lead: "Là où est née l'économie bitcoin du pays." },
    { theme: "archaeology", title: "Le Salvador maya", lead: "Tazumal, Joya de Cerén, San Andrés et Cihuatán." },
    { theme: "wellness", title: "Thermes et bien-être", lead: "Sources chaudes et repos en montagne." },
  ],
};
const rows = ROWS[lang];
const themed = rows
  .map((row) => ({ ...row, items: destinations.filter((place) => place.themes.includes(row.theme)).sort((a, b) => b.photos.length - a.photos.length).slice(0, 10) }))
  .filter((row) => row.items.length);
const departments = await Promise.all(
  DEPARTMENTS.map(async (name) => {
    const here = byDepartment(name);
    const lead = here.find((place) => place.photos.length && place.kind === "destination") ?? here.find((place) => place.photos.length);
    return { name, count: here.length, lead: DEPARTMENT_LEAD[lang][name], photo: await picture(lead?.photos[0]?.src, [480, 800]) };
  }),
);
const quick = (["lodging", "restaurant", "surf_school", "guide", "transport", "attraction"] as Kind[]).filter((kind) => (byKind.get(kind) ?? 0) > 0);
const surf = destinations.filter((place) => place.themes.includes("surf_city")).map((place) => place.name);
const bitcoin = destinations.filter((place) => place.themes.includes("bitcoin")).map((place) => place.name);
const guides = byKind.get("guide") ?? 0;
const AND: Record<typeof lang, string> = { es: "y", en: "and", pt: "e", fr: "et" };
const list = (names: string[], limit = 5) => (names.length <= 1 ? names.join("") : `${names.slice(0, limit - 1).join(", ")} ${AND[lang]} ${names.slice(limit - 1, limit)[0] ?? names.at(-1)}`);
const COPY = {
  es: {
    title: "Turismo en El Salvador: playas, volcanes, hoteles y qué hacer | Ventanilla",
    description: `Planea tu viaje a El Salvador: playas de surf, volcanes, pueblos, ${number(byKind.get("lodging") ?? 0)} hospedajes, ${number(byKind.get("restaurant") ?? 0)} restaurantes, guías certificados y eventos, con mapa y contactos.`,
    page: "Turismo en El Salvador",
    pageDescription: `Playas, volcanes, pueblos, hoteles, restaurantes, guías y eventos de El Salvador: ${number(total)} lugares del directorio oficial del Ministerio de Turismo.`,
    region: "América Central",
    faq: [
      { q: "¿Qué lugares turísticos hay en El Salvador?", a: `El directorio oficial del Ministerio de Turismo reúne ${number(total)} lugares: ${destinations.length} destinos y sitios turísticos, ${number(byKind.get("lodging") ?? 0)} opciones de hospedaje, ${number(byKind.get("restaurant") ?? 0)} restaurantes, escuelas de surf, transporte y ${number(guides)} guías de turismo certificados en los 14 departamentos.` },
      surf.length ? { q: "¿Dónde surfear en El Salvador?", a: `Surf City agrupa las playas de surf del país, entre ellas ${list(surf)}. La mayoría están en La Libertad, a menos de una hora de San Salvador.` } : null,
      bitcoin.length ? { q: "¿Qué son los Destinos Bitcoin?", a: `Son destinos que el Ministerio de Turismo promueve por su relación con bitcoin: ${list(bitcoin, bitcoin.length)}.` } : null,
      { q: "¿Cómo encuentro un guía de turismo certificado?", a: `El directorio incluye ${number(guides)} guías certificados, de sitio, locales y nacionales, con los idiomas en que trabajan. Puedes filtrarlos por departamento e idioma en la sección de guías.` },
    ],
    hero: { image: "Playa El Tunco al atardecer", eyebrow: "Turismo en El Salvador", title: "El Salvador, de cerca.", lead: `Playas, volcanes, pueblos y su gente: ${number(total)} lugares del directorio oficial, con mapa y contactos.`, search: "Busca o pregunta lo que quieras" },
    prompts: ["¿Dónde surfear si soy principiante?", "Un día en la Ruta de las Flores", "¿Qué hacer en Suchitoto?"],
    themes: "Temáticas",
    soon: "Qué hay pronto",
    soonLead: "Festivales, ferias y eventos de la agenda oficial.",
    agenda: "Ver agenda",
    seeAll: "Ver todo",
    plan: "Planea tu viaje",
    inDirectory: "en el directorio",
    departments: "Los 14 departamentos",
    departmentsLead: "Cada rincón del país, de la costa a la montaña.",
    places: "lugares",
    askTitle: "¿Tienes una pregunta?",
    askBody: "Ventanilla responde con el directorio oficial de turismo y fuentes del Estado: requisitos de entrada, aduanas, transporte y qué visitar.",
    asks: ["¿Qué necesito para entrar a El Salvador como turista?", "¿Cuánto equipaje puedo traer sin pagar impuestos?", "Recomiéndame hoteles cerca del lago de Coatepeque"],
    faqTitle: "Preguntas frecuentes",
    footer: "Datos del directorio oficial de turismo y la agenda del Ministerio de Turismo de El Salvador, consultados a través de Croma y actualizados a diario. Ventanilla es un proyecto independiente y no representa al Gobierno de El Salvador.",
  },
  en: {
    title: "El Salvador travel guide: beaches, volcanoes, hotels and things to do | Ventanilla",
    description: `Plan your trip to El Salvador: surf beaches, volcanoes, colonial towns, ${number(byKind.get("lodging") ?? 0)} places to stay, ${number(byKind.get("restaurant") ?? 0)} restaurants, certified guides and events, with a map and contact details.`,
    page: "El Salvador travel guide",
    pageDescription: `Beaches, volcanoes, towns, hotels, restaurants, guides and events in El Salvador: ${number(total)} places from the Ministry of Tourism's official directory.`,
    region: "Central America",
    faq: [
      { q: "What is there to see and do in El Salvador?", a: `The Ministry of Tourism's official directory lists ${number(total)} places: ${destinations.length} destinations and attractions, ${number(byKind.get("lodging") ?? 0)} places to stay, ${number(byKind.get("restaurant") ?? 0)} restaurants, surf schools, transport and ${number(guides)} certified tour guides across all 14 departments.` },
      surf.length ? { q: "Where can I surf in El Salvador?", a: `Surf City is the country's surf coast, including ${list(surf)}. Most of these beaches are in La Libertad, less than an hour from San Salvador.` } : null,
      bitcoin.length ? { q: "What are the Bitcoin destinations?", a: `They are destinations the Ministry of Tourism promotes for their ties to bitcoin: ${list(bitcoin, bitcoin.length)}.` } : null,
      { q: "How do I find a certified tour guide?", a: `The directory includes ${number(guides)} certified guides at site, local and national level, with the languages they work in. You can filter them by department and language in the guides section.` },
      { q: "Is this the official tourism website of El Salvador?", a: "No. Ventanilla is an independent project. Its tourism pages are built every day from the Ministry of Tourism's official directory and events calendar, accessed through Croma." },
    ],
    hero: { image: "El Tunco beach at sunset", eyebrow: "El Salvador travel guide", title: "El Salvador, up close.", lead: `Beaches, volcanoes, towns and their people: ${number(total)} places from the official directory, with a map and contact details.`, search: "Search or ask anything" },
    prompts: ["Where should a beginner surf?", "A day on the Ruta de las Flores", "What to do in Suchitoto?"],
    themes: "Themes",
    soon: "Coming up",
    soonLead: "Festivals, fairs and events from the official calendar.",
    agenda: "See calendar",
    seeAll: "See all",
    plan: "Plan your trip",
    inDirectory: "in the directory",
    departments: "The 14 departments",
    departmentsLead: "Every corner of the country, from the coast to the mountains.",
    places: "places",
    askTitle: "Have a question?",
    askBody: "Ventanilla answers in English from the official tourism directory and government sources: entry requirements, customs, getting around and what to see.",
    asks: ["What do I need to enter El Salvador as a tourist?", "How much can I bring in my luggage without paying duties?", "Recommend hotels near Lake Coatepeque"],
    faqTitle: "Frequently asked questions",
    footer: "Data from the official tourism directory and events calendar of El Salvador's Ministry of Tourism, accessed through Croma and updated daily. Ventanilla is an independent project and does not represent the Government of El Salvador.",
  },
  pt: {
    title: "Guia de viagem de El Salvador: praias, vulcões, hotéis e o que fazer | Ventanilla",
    description: `Planeie a sua viagem a El Salvador: praias de surf, vulcões, vilas coloniais, ${number(byKind.get("lodging") ?? 0)} alojamentos, ${number(byKind.get("restaurant") ?? 0)} restaurantes, guias certificados e eventos, com mapa e contactos.`,
    page: "Guia de viagem de El Salvador",
    pageDescription: `Praias, vulcões, vilas, hotéis, restaurantes, guias e eventos em El Salvador: ${number(total)} locais do diretório oficial do Ministério do Turismo.`,
    region: "América Central",
    faq: [
      { q: "O que há para ver e fazer em El Salvador?", a: `O diretório oficial do Ministério do Turismo reúne ${number(total)} locais: ${destinations.length} destinos e atrações, ${number(byKind.get("lodging") ?? 0)} alojamentos, ${number(byKind.get("restaurant") ?? 0)} restaurantes, escolas de surf, transportes e ${number(guides)} guias turísticos certificados nos 14 departamentos.` },
      surf.length ? { q: "Onde fazer surf em El Salvador?", a: `A Surf City é a costa de surf do país, com praias como ${list(surf)}. A maioria fica em La Libertad, a menos de uma hora de San Salvador.` } : null,
      bitcoin.length ? { q: "O que são os Destinos Bitcoin?", a: `São destinos que o Ministério do Turismo promove pela sua ligação à bitcoin: ${list(bitcoin, bitcoin.length)}.` } : null,
      { q: "Como encontro um guia turístico certificado?", a: `O diretório inclui ${number(guides)} guias certificados, de local, locais e nacionais, com os idiomas em que trabalham. Pode filtrá-los por departamento e idioma na secção de guias.` },
      { q: "Este é o site oficial de turismo de El Salvador?", a: "Não. A Ventanilla é um projeto independente. As suas páginas de turismo são criadas todos os dias a partir do diretório oficial e da agenda do Ministério do Turismo, consultados através da Croma." },
    ],
    hero: { image: "Praia de El Tunco ao pôr do sol", eyebrow: "Guia de viagem de El Salvador", title: "El Salvador, de perto.", lead: `Praias, vulcões, vilas e a sua gente: ${number(total)} locais do diretório oficial, com mapa e contactos.`, search: "Pesquise ou pergunte o que quiser" },
    prompts: ["Onde fazer surf se for principiante?", "Um dia na Ruta de las Flores", "O que fazer em Suchitoto?"],
    themes: "Temas",
    soon: "Em breve",
    soonLead: "Festivais, feiras e eventos da agenda oficial.",
    agenda: "Ver agenda",
    seeAll: "Ver tudo",
    plan: "Planeie a sua viagem",
    inDirectory: "no diretório",
    departments: "Os 14 departamentos",
    departmentsLead: "Cada canto do país, da costa à montanha.",
    places: "locais",
    askTitle: "Tem uma pergunta?",
    askBody: "A Ventanilla responde em português com o diretório oficial de turismo e fontes do Estado: requisitos de entrada, alfândega, transportes e o que visitar.",
    asks: ["O que preciso para entrar em El Salvador como turista?", "Quanto posso trazer na bagagem sem pagar impostos?", "Recomende-me hotéis perto do lago de Coatepeque"],
    faqTitle: "Perguntas frequentes",
    footer: "Dados do diretório oficial de turismo e da agenda do Ministério do Turismo de El Salvador, consultados através da Croma e atualizados diariamente. A Ventanilla é um projeto independente e não representa o Governo de El Salvador.",
  },
  fr: {
    title: "Guide de voyage du Salvador : plages, volcans, hôtels et que faire | Ventanilla",
    description: `Préparez votre voyage au Salvador : plages de surf, volcans, villages coloniaux, ${number(byKind.get("lodging") ?? 0)} hébergements, ${number(byKind.get("restaurant") ?? 0)} restaurants, guides certifiés et événements, avec carte et coordonnées.`,
    page: "Guide de voyage du Salvador",
    pageDescription: `Plages, volcans, villages, hôtels, restaurants, guides et événements au Salvador : ${number(total)} lieux de l'annuaire officiel du ministère du Tourisme.`,
    region: "Amérique centrale",
    faq: [
      { q: "Que voir et que faire au Salvador ?", a: `L'annuaire officiel du ministère du Tourisme recense ${number(total)} lieux : ${destinations.length} destinations et sites, ${number(byKind.get("lodging") ?? 0)} hébergements, ${number(byKind.get("restaurant") ?? 0)} restaurants, des écoles de surf, des transports et ${number(guides)} guides touristiques certifiés dans les 14 départements.` },
      surf.length ? { q: "Où surfer au Salvador ?", a: `Surf City est la côte du surf du pays, avec des plages comme ${list(surf)}. La plupart se trouvent à La Libertad, à moins d'une heure de San Salvador.` } : null,
      bitcoin.length ? { q: "Que sont les Destinations Bitcoin ?", a: `Ce sont des destinations que le ministère du Tourisme met en avant pour leur lien avec le bitcoin : ${list(bitcoin, bitcoin.length)}.` } : null,
      { q: "Comment trouver un guide touristique certifié ?", a: `L'annuaire compte ${number(guides)} guides certifiés, de site, locaux et nationaux, avec les langues dans lesquelles ils travaillent. Vous pouvez les filtrer par département et par langue dans la section des guides.` },
      { q: "Est-ce le site officiel du tourisme au Salvador ?", a: "Non. Ventanilla est un projet indépendant. Ses pages touristiques sont générées chaque jour à partir de l'annuaire officiel et de l'agenda du ministère du Tourisme, consultés via Croma." },
    ],
    hero: { image: "La plage d'El Tunco au coucher du soleil", eyebrow: "Guide de voyage du Salvador", title: "Le Salvador, de près.", lead: `Plages, volcans, villages et leurs habitants : ${number(total)} lieux de l'annuaire officiel, avec carte et coordonnées.`, search: "Cherchez ou posez votre question" },
    prompts: ["Où surfer quand on débute ?", "Une journée sur la Ruta de las Flores", "Que faire à Suchitoto ?"],
    themes: "Thèmes",
    soon: "À venir",
    soonLead: "Festivals, foires et événements de l'agenda officiel.",
    agenda: "Voir l'agenda",
    seeAll: "Tout voir",
    plan: "Préparez votre voyage",
    inDirectory: "dans l'annuaire",
    departments: "Les 14 départements",
    departmentsLead: "Chaque recoin du pays, de la côte à la montagne.",
    places: "lieux",
    askTitle: "Une question ?",
    askBody: "Ventanilla répond en français à partir de l'annuaire officiel du tourisme et des sources de l'État : conditions d'entrée, douane, transports et que visiter.",
    asks: ["De quoi ai-je besoin pour entrer au Salvador en tant que touriste ?", "Combien puis-je apporter dans mes bagages sans payer de taxes ?", "Recommandez-moi des hôtels près du lac de Coatepeque"],
    faqTitle: "Questions fréquentes",
    footer: "Données de l'annuaire officiel du tourisme et de l'agenda du ministère du Tourisme du Salvador, consultées via Croma et mises à jour chaque jour. Ventanilla est un projet indépendant et ne représente pas le gouvernement du Salvador.",
  },
}[lang];
const faq = COPY.faq.filter((entry): entry is { q: string; a: string } => entry !== null);

const schema = [
  {
    "@type": "CollectionPage",
    "@id": `${url}#page`,
    url,
    name: COPY.page,
    description: COPY.pageDescription,
    inLanguage: LOCALE[lang],
    about: { "@type": "TouristDestination", name: "El Salvador", containedInPlace: { "@type": "Place", name: COPY.region } },
    mainEntity: {
      "@type": "ItemList",
      itemListElement: destinations.slice(0, 30).map((place, index) => ({ "@type": "ListItem", position: index + 1, name: place.name, url: new URL(placePath(place, lang), origin).href })),
    },
  },
  { "@type": "FAQPage", "@id": `${url}#faq`, mainEntity: faq.map((entry) => ({ "@type": "Question", name: entry.q, acceptedAnswer: { "@type": "Answer", text: entry.a } })) },
];
const link = `rounded-4 underline-offset-4 hover:underline ${focusRing}`;
---

<Layout title={COPY.title} description={COPY.description} current="home" schema={schema} image={{ path: "/hero/sv/el-tunco.webp", width: 1344, height: 896, alt: COPY.hero.image }}>
  <section slot="hero" class="relative isolate -mt-24 mb-2 flex min-h-[86svh] items-end overflow-hidden mobile:-mt-36 mobile:min-h-[78svh]" aria-labelledby="turismo-title">
    <img
      src="/hero/sv/el-tunco.webp"
      srcset="/hero/sv/el-tunco-640.webp 640w, /hero/sv/el-tunco-800.webp 800w, /hero/sv/el-tunco.webp 1344w"
      sizes="100vw"
      alt={COPY.hero.image}
      width="1344"
      height="896"
      fetchpriority="high"
      class="absolute inset-0 -z-10 size-full object-cover"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-[#050b1c] via-[#050b1c]/55 to-[#050b1c]/10"></div>
    <div class="mx-auto w-full max-w-[860px] px-4 pt-40 pb-12 text-center text-white mobile:px-6 mobile:pb-16">
      <p class="text-[13px] font-semibold tracking-[0.18em] text-white/75 uppercase">{COPY.hero.eyebrow}</p>
      <h1 id="turismo-title" class="mt-3 font-serif-display text-[clamp(3.2rem,12vw,6.5rem)] leading-[0.92] tracking-[-0.025em] text-balance">{COPY.hero.title}</h1>
      <p class="mx-auto mt-5 max-w-[34ch] text-[18px] leading-snug text-pretty text-white/85 mobile:text-[20px]">
        {COPY.hero.lead}
      </p>
      <div class="mx-auto mt-8 max-w-[620px]">
        <TurismoSearch client:load placeholder={COPY.hero.search} prompts={COPY.prompts} lang={lang} />
      </div>
    </div>
  </section>

  <nav aria-label={COPY.themes} class="mt-6">
    <ul class="-mx-4 flex gap-2 overflow-x-auto px-4 pb-1 [scrollbar-width:none] mobile:-mx-6 mobile:px-6 [&::-webkit-scrollbar]:hidden">
      {rows.map((row) => <li class="shrink-0"><a href={exploreHref(lang, { theme: row.theme })} class={`inline-flex h-10 items-center rounded-full border border-border-tertiary px-4 text-[14px] font-medium hover:bg-surface-muted ${focusRing}`}>{THEME_LABEL[lang][row.theme]}</a></li>)}
    </ul>
  </nav>

  {
    soon.length > 0 && (
      <section class="mt-14" aria-labelledby="pronto">
        <div class="flex items-end justify-between gap-4">
          <div>
            <h2 id="pronto" class="font-serif-display text-[2.4rem] leading-none">{COPY.soon}</h2>
            <p class="mt-2 text-[15px] text-text-secondary">{COPY.soonLead}</p>
          </div>
          <a href={sectionPath("events", lang)} class={`shrink-0 text-[15px] font-medium ${link}`}>{COPY.agenda}</a>
        </div>
        <div class="-mx-4 mt-5 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-2 [scrollbar-width:none] mobile:-mx-6 mobile:px-6 [&::-webkit-scrollbar]:hidden">
          {soon.map((event) => <EventCard event={event} variant="compact" lang={lang} />)}
        </div>
      </section>
    )
  }

  {
    themed.map((row) => (
      <section class="mt-14" aria-labelledby={`tema-${row.theme}`}>
        <div class="flex items-end justify-between gap-4">
          <div>
            <h2 id={`tema-${row.theme}`} class="font-serif-display text-[2.4rem] leading-none">{row.title}</h2>
            <p class="mt-2 text-[15px] text-text-secondary">{row.lead}</p>
          </div>
          <a href={exploreHref(lang, { theme: row.theme })} class={`shrink-0 text-[15px] font-medium ${link}`}>{COPY.seeAll}</a>
        </div>
        <div class="-mx-4 mt-5 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-2 [scrollbar-width:none] mobile:-mx-6 mobile:px-6 [&::-webkit-scrollbar]:hidden">
          {row.items.map((place) => <PlaceCard place={place} variant="compact" lang={lang} />)}
        </div>
      </section>
    ))
  }

  <section class="mt-16" aria-labelledby="planea">
    <h2 id="planea" class="font-serif-display text-[2.4rem] leading-none">{COPY.plan}</h2>
    <ul class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3">
      {
        quick.map((kind) => (
          <li>
            <a href={kind === "guide" ? sectionPath("guides", lang) : exploreHref(lang, { kind })} class={`flex h-full flex-col gap-3 rounded-24 bg-surface-muted p-4 transition-colors hover:bg-background-secondary ${focusRing}`}>
              <span class="inline-flex size-11 items-center justify-center rounded-full bg-white shadow-sm"><KindIcon kind={kind} size={20} /></span>
              <span class="font-serif-display text-[1.45rem] leading-none">{KIND_LABEL[lang][kind].many}</span>
              <span class="text-[13px] text-text-secondary">{number(byKind.get(kind) ?? 0)} {COPY.inDirectory}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-16" aria-labelledby="departamentos">
    <h2 id="departamentos" class="font-serif-display text-[2.4rem] leading-none">{COPY.departments}</h2>
    <p class="mt-2 text-[15px] text-text-secondary">{COPY.departmentsLead}</p>
    <ul class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2 site-desktop:grid-cols-3">
      {
        departments.map((department) => (
          <li>
            <a href={departmentPath(department.name, lang)} class={`group relative flex aspect-[5/3] overflow-hidden rounded-24 bg-blue-700 ${focusRing}`}>
              {department.photo && <img src={department.photo.src} srcset={department.photo.srcset} sizes="(min-width: 1145px) 380px, (min-width: 640px) 45vw, 92vw" alt="" width="800" height="533" loading="lazy" decoding="async" class="absolute inset-0 size-full object-cover transition-transform duration-500 ease-out-quint group-hover:scale-[1.04]" />}
              <span class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/20 to-transparent" />
              <span class="relative mt-auto flex flex-col gap-1 p-5 text-white">
                <span class="font-serif-display text-[2rem] leading-none">{department.name}</span>
                <span class="text-[14px] text-pretty text-white/85">{department.lead}</span>
                <span class="mt-1 text-[12px] font-medium text-white/70">{number(department.count)} {COPY.places}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-16 overflow-hidden rounded-32 bg-blue-700 p-6 text-white mobile:p-10" aria-labelledby="pregunta">
    <h2 id="pregunta" class="font-serif-display text-[clamp(2.2rem,6vw,3.2rem)] leading-[0.98]">{COPY.askTitle}</h2>
    <p class="mt-3 max-w-[46ch] text-[16px] text-white/75">{COPY.askBody}</p>
    <ul class="mt-6 flex flex-col gap-2 sm:flex-row sm:flex-wrap">
      {
        COPY.asks.map((prompt) => (
          <li><a href={`/?q=${encodeURIComponent(prompt)}`} rel="nofollow" class={`inline-flex rounded-full bg-white/10 px-4 py-2.5 text-[15px] ring-1 ring-white/20 transition-colors hover:bg-white/20 ${focusRing}`}>{prompt}</a></li>
        ))
      }
    </ul>
  </section>

  <section class="mt-16" aria-labelledby="faq">
    <h2 id="faq" class="font-serif-display text-[2.4rem] leading-none">{COPY.faqTitle}</h2>
    <dl class="mt-5 divide-y divide-border-quaternary rounded-24 border border-border-quaternary">
      {faq.map((entry) => (
        <div class="p-5">
          <dt class="font-medium">{entry.q}</dt>
          <dd class="mt-1.5 text-[15px] leading-relaxed text-text-secondary">{entry.a}</dd>
        </div>
      ))}
    </dl>
  </section>

  <p class="mt-12 max-w-[68ch] text-[13px] leading-relaxed text-text-tertiary">
    {COPY.footer}
  </p>
</Layout>
